{
  "name": "lupiramtgmobile",
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:openapi": "node scripts/fetch-openapi.mjs",
    "fetch:symbols": "node scripts/fetch-symbols.mjs",
    "generate:api": "orval --config ./orval.config.ts",
    "regen:api": "npm run fetch:openapi && npm run generate:api"
  },
  "dependencies": {
    "@danbro96/lupira-expo-diagnostics": "0.3.2",
    "@danbro96/lupira-expo-feedback": "1.0.0",
    "@danbro96/lupira-expo-oidc": "0.4.2",
    "@danbro96/lupira-expo-paper": "0.9.0",
    "@danbro96/lupira-expo-query": "0.1.4",
    "@danbro96/lupira-http": "0.3.0",
    "@danbro96/lupira-tokens-core": "0.3.0",
    "@expo/vector-icons": "15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@sentry/react-native": "8.34.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.107.1",
    "babel-preset-expo": "~58.0.24",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fast-opencv": "0.4.8",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-paper": "5.15.4",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-worklets": "5.2.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@danbro96/lupira-config-ts": "0.1.0",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "orval": "8.47.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.10.0"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli": false,
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
